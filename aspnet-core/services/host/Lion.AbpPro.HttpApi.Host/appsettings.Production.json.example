{
  // Kestrel 监听地址（SelfUrl 不控制端口，见 App:SelfUrl 仅用于生成绝对地址）
  "Urls": "http://localhost:44315",
  "ConnectionStrings": {
    "Default": "User ID=postgres;Password=<YOUR_DB_PASSWORD>;Host=localhost;Port=5432;Database=LionAbpProDb160;"
  },
  "Hangfire": {
    "Redis": {
      "Host": "localhost:6379,password=<YOUR_PASSWORD>",
      "DB": "2"
    }
  },
  "Redis": {
    // ABP 的 AbpCachingStackExchangeRedisModule 在缺少 IsEnabled 时按“启用”处理，
    // 会去连 localhost:6379；本机未部署 Redis 时置为 false，回落到内存缓存（多实例部署再改回 true）
    "IsEnabled": false,
    "Configuration": "localhost:6379,password=<YOUR_PASSWORD>,defaultdatabase=2"
  },
  "Jwt": {
    "Audience": "Lion.AbpPro",
    "SecurityKey": "dzehzRz9a8asdfasfdadfasdfasdfafsdadfasbasdf=",
    "Issuer": "Lion.AbpPro",
    "ExpirationTime": 2
  },
  "Cap": {
    "RabbitMq": {
      "HostName": "localhost",
      "UserName": "admin",
      "Password": "<YOUR_PASSWORD>",
      "Port": 5672
    }
  },
  "MiniProfiler": {
    "Enabled": true,
    "RouteBasePath": "/profiler"
  },
  "Swagger": {
    "Enabled": true
  },
  "Audit": {
    "Enabled": true,
    "ApplicationName": "Lion.AbpPro"
  },
  "Cors": {
    "Enabled": true,
    "CorsOrigins": "http://localhost:4200,http://localhost:4201,http://localhost:44315,http://127.0.0.1:44315"
  },
  "Consul": {
    "Enabled": false,
    "ServiceUrl": "http://localhost:8500",
    "ClientName": "Lion.AbpPro.Api",
    "ClientAddress": "localhost",
    "ClientPort": 44315,
    "HealthUrl": "http://localhost:44315/health",
    "DeregisterCriticalServiceAfter": 30,
    "Interval": 30,
    "Timeout": 30
  },
  "MultiTenancy": {
    "Enabled": true
  },
  "Preheat": {
    "Enabled": true,
    "RequestUrl": "http://localhost:44315/api/abp/application-configuration?IncludeLocalizationResources=false"
  }
}